# Optional Sentry frontend error monitoring.
# Public browser DSN only; never put Gemini, Firebase Admin, payment, or private keys here.
REACT_APP_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
REACT_APP_SENTRY_ENVIRONMENT=development
REACT_APP_SENTRY_RELEASE=local-dev
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0

# Firebase Console -> Project settings -> Cloud Messaging -> Web Push certificates.
REACT_APP_FIREBASE_VAPID_KEY=
