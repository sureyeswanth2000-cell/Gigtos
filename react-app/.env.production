# Sentry frontend error monitoring — production only.
# Browser-safe public DSN. Never put Firebase Admin keys, payment secrets, or tokens here.
#
# HOW TO GET YOUR DSN:
#   1. Go to https://sentry.io  →  Sign in with Google
#   2. Create project: platform = React, name = gigtos-frontend
#   3. Settings → Client Keys (DSN) → copy the DSN string
#   4. Replace the placeholder below and save.
#
REACT_APP_SENTRY_DSN=https://cda9cd827ae492766e7453785e130d4a@o4511495130972160.ingest.de.sentry.io/4511495187529808
REACT_APP_SENTRY_ENVIRONMENT=production
REACT_APP_SENTRY_RELEASE=1.0.0
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0
APPCHECK_DOMAIN_VERIFIED=true
# Source maps deployed publicly with the build so Sentry can read stack traces
GENERATE_SOURCEMAP=true
